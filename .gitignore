# ---- 敏感数据 ----
# 浏览器登录会话（含 cookie）
yuque_profile/
# 抓包文件，可能含 token/cookie
*.har

# ---- 运行产物：个人知识库内容 ----
# 下载的 .lakebook 与转换出的 Markdown
export/
books.json
selected_books.json

# ---- 打包产物：中间文件可由 Build-Windows.bat 重新生成 ----
build/
*.spec
# 打包产物全部忽略：发布文件由 GitHub Actions 构建并上传 Releases
dist/
YuqueExporter.zip

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
